APP_NAME=Dispatch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ka
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Tbilisi
VITE_APP_TIMEZONE=Asia/Tbilisi
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000
SESSION_DOMAIN=localhost
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=delivery_app
DB_USERNAME=root
DB_PASSWORD=
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=debug
MAIL_MAILER=log

# Map tiles and initial picker view (Tbilisi). No API key is required for this default.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_CENTER_LATITUDE=41.7151
VITE_MAP_CENTER_LONGITUDE=44.8271
# When changing tile providers, also set their required attribution HTML.
# VITE_MAP_TILE_ATTRIBUTION=

# Photon-compatible address suggestions. Replace with your own/provider endpoint as needed.
GEOCODING_URL=https://photon.komoot.io/api/

# OSRM-compatible driving directions / travel-time matrix. Use a dedicated endpoint for production traffic.
ROUTING_URL=https://router.project-osrm.org
ROUTING_PROFILE=driving

# Optional locally; mandatory when bootstrapping a production administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=
